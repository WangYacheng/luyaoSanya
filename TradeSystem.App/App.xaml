<Application x:Class="TradeSystem.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:local="clr-namespace:TradeSystem.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
         
    </Application.Resources>
</Application>
<!--
    这个文件定义了 WPF 应用程序的入口点和全局资源。
    StartupUri="MainWindow.xaml" 指定了应用程序启动时显示的主窗口。
    Application.Resources 部分可以用来定义全局可用的资源，如样式、模板等。>