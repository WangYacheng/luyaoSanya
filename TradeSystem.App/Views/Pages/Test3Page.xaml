<Page x:Class="TradeSystem.App.Views.Pages.Test3Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TradeSystem.App.Views.Pages"
      xmlns:converters="clr-namespace:TradeSystem.App.Converters"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:Test3Page, IsDesignTimeCreatable=False}"
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="交易所K线请求测试"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- 上区：参数输入 -->
        <GroupBox Grid.Row="0" Header="请求参数" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8">
            <StackPanel Margin="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 交易所 -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="交易所" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ViewModel.ExchangeOptions}"
                                  SelectedItem="{Binding ViewModel.Exchange}"
                                  Height="32"/>
                    </StackPanel>

                    <!-- 周期 -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="周期" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ViewModel.IntervalOptions}"
                                  SelectedItem="{Binding ViewModel.Interval}"
                                  Height="32"/>
                    </StackPanel>

                    <!-- 目标根数 -->
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="K线总根数" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ViewModel.Limit, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- 单次上限 -->
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="单次请求上限" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ViewModel.BatchSize, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- 交易对 -->
                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Text="交易对" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ViewModel.Symbol, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32" VerticalContentAlignment="Center"
                                 CharacterCasing="Upper"/>
                    </StackPanel>

                    <!-- 请求按钮 -->
                    <Button Grid.Column="5"
                            Content="请求K线数据"
                            Command="{Binding ViewModel.RequestKlinesCommand}"
                            IsEnabled="{Binding ViewModel.IsLoading, Converter={StaticResource InvertBoolConverter}}"
                            Width="110" Height="56"
                            Background="#007ACC" Foreground="White" BorderThickness="0"
                            VerticalAlignment="Bottom">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- 中区：DataGrid 结果 -->
        <GroupBox Grid.Row="1" Header="K线数据" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8">
            <DataGrid ItemsSource="{Binding ViewModel.KLineResults}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F8F8F8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="开盘时间" Binding="{Binding OpenTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="140"/>
                    <DataGridTextColumn Header="开盘价" Binding="{Binding Open, StringFormat='N4'}" Width="80"/>
                    <DataGridTextColumn Header="最高价" Binding="{Binding High, StringFormat='N4'}" Width="80"/>
                    <DataGridTextColumn Header="最低价" Binding="{Binding Low, StringFormat='N4'}" Width="80"/>
                    <DataGridTextColumn Header="收盘价" Binding="{Binding Close, StringFormat='N4'}" Width="80"/>
                    <DataGridTextColumn Header="成交量" Binding="{Binding Volume, StringFormat='N2'}" Width="100"/>
                    <DataGridTextColumn Header="成交额" Binding="{Binding QuoteVolume, StringFormat='N2'}" Width="120"/>
                    <DataGridTextColumn Header="涨跌幅%" Binding="{Binding ChangePct, StringFormat='N2'}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 下区：日志 -->
        <GroupBox Grid.Row="2" Header="日志" FontSize="13" FontWeight="SemiBold">
            <TextBox Text="{Binding ViewModel.LogOutput, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Background="White"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="5"
                     BorderThickness="0"/>
        </GroupBox>
    </Grid>
</Page>
