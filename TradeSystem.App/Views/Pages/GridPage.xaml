<Page
  x:Class="TradeSystem.App.Views.Pages.GridPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:TradeSystem.App.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:converters="clr-namespace:TradeSystem.App.Converters"
  Title="GridPage"
  d:DataContext="{d:DesignInstance local:GridPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="600"
  d:DesignWidth="900"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  mc:Ignorable="d">

    <Page.Resources>
        <converters:IntEqualsVisibilityConverter x:Key="IntEqualsVisibilityConverter" />
        <Style x:Key="DemoButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="CellLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：Demo 切换按钮 -->
        <Border Grid.Row="0" Padding="8" Margin="0,0,0,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Grid 布局用法演示" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding ViewModel.DemoNames}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Style="{StaticResource DemoButtonStyle}"
                                    Command="{Binding DataContext.ViewModel.SelectDemoCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 中部：Demo 内容区 -->
        <Border Grid.Row="1" Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="6">
            <Grid>
            <!-- ============================================================ -->
            <!-- Demo 0: 基础行列定义 -->
            <!-- ============================================================ -->
            <Border Visibility="{Binding ViewModel.SelectedDemo, Converter={StaticResource IntEqualsVisibilityConverter}, ConverterParameter=0}">
                <Grid ShowGridLines="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="#4A90D9">
                        <TextBlock Text="Row=0, Col=0" Style="{StaticResource CellLabelStyle}" Foreground="White"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#5BA0E9">
                        <TextBlock Text="Row=0, Col=1" Style="{StaticResource CellLabelStyle}" Foreground="White"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Background="#6CB0F9">
                        <TextBlock Text="Row=0, Col=2" Style="{StaticResource CellLabelStyle}" Foreground="White"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Background="#E07B5A">
                        <TextBlock Text="Row=1, Col=0" Style="{StaticResource CellLabelStyle}" Foreground="White"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Background="#E9906A">
                        <TextBlock Text="Row=1, Col=1" Style="{StaticResource CellLabelStyle}" Foreground="White"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Background="#F0A07A">
                        <TextBlock Text="Row=1, Col=2" Style="{StaticResource CellLabelStyle}" Foreground="White"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" Background="#5A9E6F">
                        <TextBlock Text="Row=2, Col=0" Style="{StaticResource CellLabelStyle}" Foreground="White"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Background="#6AAE7F">
                        <TextBlock Text="Row=2, Col=1" Style="{StaticResource CellLabelStyle}" Foreground="White"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Background="#7ABE8F">
                        <TextBlock Text="Row=2, Col=2" Style="{StaticResource CellLabelStyle}" Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- Demo 1: Auto与Star混合 -->
            <!-- ============================================================ -->
            <Border Visibility="{Binding ViewModel.SelectedDemo, Converter={StaticResource IntEqualsVisibilityConverter}, ConverterParameter=1}">
                <Grid ShowGridLines="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Auto 行：高度由内容撑开 -->
                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#FFE082" Padding="6">
                        <TextBlock Text="Row=0 Height=Auto — 高度由内容决定" Style="{StaticResource CellLabelStyle}"/>
                    </Border>

                    <!-- * 行：占剩余空间的 1 份 -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#90CAF9" Padding="6">
                        <TextBlock Text="Row=1 Height=* (1份)" Style="{StaticResource CellLabelStyle}"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Background="#A5D8FA" Padding="6">
                        <TextBlock Text="Col=1 Width=* (1份)" Style="{StaticResource CellLabelStyle}"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Background="#BBDEFB" Padding="6">
                        <TextBlock Text="Col=2 Width=2* (2份)" Style="{StaticResource CellLabelStyle}"/>
                    </Border>

                    <!-- 2* 行：占剩余空间的 2 份 -->
                    <Border Grid.Row="2" Grid.Column="0" Background="#A5D6A7" Padding="6">
                        <TextBlock Text="Row=2 Height=2* (2份)" Style="{StaticResource CellLabelStyle}"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Background="#C8E6C9" Padding="6">
                        <TextBlock Text="1份 Col + 2份 Row" Style="{StaticResource CellLabelStyle}"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Background="#E8F5E9" Padding="6">
                        <TextBlock Text="2份 Col + 2份 Row" Style="{StaticResource CellLabelStyle}"/>
                    </Border>

                    <!-- 固定行 -->
                    <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#FFCC80" Padding="6">
                        <TextBlock Text="Row=3 Height=50 — 固定像素高度" Style="{StaticResource CellLabelStyle}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- Demo 2: 跨行跨列 (RowSpan / ColumnSpan) -->
            <!-- ============================================================ -->
            <Border Visibility="{Binding ViewModel.SelectedDemo, Converter={StaticResource IntEqualsVisibilityConverter}, ConverterParameter=2}">
                <Grid ShowGridLines="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 跨 4 列 -->
                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Background="#7C4DFF" Padding="6">
                        <TextBlock Text="ColumnSpan=4 跨全部列" Style="{StaticResource CellLabelStyle}" Foreground="White"/>
                    </Border>

                    <!-- 跨 3 行 -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="3" Background="#448AFF" Padding="6">
                        <TextBlock Text="RowSpan=3 跨3行" Style="{StaticResource CellLabelStyle}" Foreground="White"/>
                    </Border>

                    <!-- 跨 2 列 + 1 行 -->
                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="#69F0AE" Padding="6">
                        <TextBlock Text="ColumnSpan=2" Style="{StaticResource CellLabelStyle}"/>
                    </Border>

                    <!-- 常规单格 -->
                    <Border Grid.Row="1" Grid.Column="3" Background="#B388FF" Padding="6">
                        <TextBlock Text="1×1" Style="{StaticResource CellLabelStyle}" Foreground="White"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="2" Background="#FF6E40" Padding="6">
                        <TextBlock Text="RowSpan=2 + ColumnSpan=3" Style="{StaticResource CellLabelStyle}" Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- Demo 3: 嵌套 Grid -->
            <!-- ============================================================ -->
            <Border Visibility="{Binding ViewModel.SelectedDemo, Converter={StaticResource IntEqualsVisibilityConverter}, ConverterParameter=3}">
                <Grid ShowGridLines="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="#FFE082" Padding="6">
                        <TextBlock Text="外层 (0,0)" Style="{StaticResource CellLabelStyle}"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="#FFE082" Padding="6">
                        <TextBlock Text="外层 (0,1)" Style="{StaticResource CellLabelStyle}"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Background="#FFE082" Padding="6">
                        <TextBlock Text="外层 (1,0)" Style="{StaticResource CellLabelStyle}"/>
                    </Border>

                    <!-- 嵌套 Grid 在 (1,1) 中 -->
                    <Border Grid.Row="1" Grid.Column="1" Background="#E0E0E0" Padding="4">
                        <Grid ShowGridLines="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="#4FC3F7" Padding="3">
                                <TextBlock Text="内(0,0)" Style="{StaticResource CellLabelStyle}" Foreground="White" FontSize="10"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Background="#29B6F6" Padding="3">
                                <TextBlock Text="内(0,1)" Style="{StaticResource CellLabelStyle}" Foreground="White" FontSize="10"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Background="#03A9F4" Padding="3">
                                <TextBlock Text="内(1,0)" Style="{StaticResource CellLabelStyle}" Foreground="White" FontSize="10"/>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Background="#039BE5" Padding="3">
                                <TextBlock Text="内(1,1)" Style="{StaticResource CellLabelStyle}" Foreground="White" FontSize="10"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- Demo 4: 对齐方式 -->
            <!-- ============================================================ -->
            <Border Visibility="{Binding ViewModel.SelectedDemo, Converter={StaticResource IntEqualsVisibilityConverter}, ConverterParameter=4}">
                <Grid ShowGridLines="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 九宫格对齐演示 -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#F5F5F5">
                        <Button Content="左上 (默认)"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Width="80" Height="28" FontSize="10"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#F5F5F5">
                        <Button Content="中上"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Width="80" Height="28" FontSize="10"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Background="#F5F5F5">
                        <Button Content="右上"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="80" Height="28" FontSize="10"/>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Background="#F5F5F5">
                        <Button Content="左中"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Width="80" Height="28" FontSize="10"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Background="#F5F5F5">
                        <Button Content="居中 (Center)"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="80" Height="28" FontSize="10"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Background="#F5F5F5">
                        <Button Content="右中"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="80" Height="28" FontSize="10"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Background="#F5F5F5">
                        <Button Content="左下"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Width="80" Height="28" FontSize="10"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Background="#F5F5F5">
                        <Button Content="中下"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Width="80" Height="28" FontSize="10"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Background="#F5F5F5">
                        <Button Content="右下"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Width="80" Height="28" FontSize="10"/>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Border>

        <!-- 底部：说明文字 -->
        <Border Grid.Row="2" Padding="8" Margin="0,8,0,0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="6">
            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="Grid 是 WPF 最强大的布局容器。RowDefinitions / ColumnDefinitions 定义行列结构，"/>
                <Run Text="Grid.Row / Grid.Column 指定位置，Grid.RowSpan / Grid.ColumnSpan 实现跨行跨列。"/>
                <Run Text="Height/Width 支持 Auto(自适应)、*(按比例)、固定像素三种模式。"/>
            </TextBlock>
        </Border>
    </Grid>
</Page>
