<Page x:Class="TradeSystem.App.Views.Pages.DataDownloadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TradeSystem.App.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="DataDownloadPage"
      d:DataContext="{d:DesignInstance local:DataDownloadPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="600"
      d:DesignWidth="900"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <Grid Margin="42">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 下载按钮 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Margin="0,0,0,12"
                Text="K线数据下载" />
            <StackPanel Orientation="Horizontal">
                <Button
                    Width="180"
                    Height="44"
                    Margin="0,0,12,0"
                    Background="#1A1A1A"
                    BorderThickness="0"
                    Command="{Binding ViewModel.DownloadOkxCommand}"
                    Content="下载 OKX K线"
                    Cursor="Hand"
                    FontSize="15"
                    Foreground="White">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
                <Button
                    Width="180"
                    Height="44"
                    Background="#F0B90B"
                    BorderThickness="0"
                    Command="{Binding ViewModel.DownloadBinanceCommand}"
                    Content="下载 Binance K线"
                    Cursor="Hand"
                    FontSize="15"
                    Foreground="#1E2329">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- OKX 进度 -->
        <GroupBox Grid.Row="1" Header="OKX" Margin="0,0,0,8">
            <StackPanel Margin="4,8">
                <ProgressBar
                    Margin="0,0,0,4"
                    Maximum="{Binding ViewModel.OkxTotal, FallbackValue=1}"
                    Minimum="0"
                    Value="{Binding ViewModel.OkxCurrent}" />
                <TextBlock FontSize="13">
                    <Run Text="{Binding ViewModel.OkxCurrent}" />
                    <Run Text=" / " />
                    <Run Text="{Binding ViewModel.OkxTotal}" />
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <!-- Binance 进度 -->
        <GroupBox Grid.Row="2" Header="Binance" Margin="0,0,0,8">
            <StackPanel Margin="4,8">
                <ProgressBar
                    Margin="0,0,0,4"
                    Maximum="{Binding ViewModel.BinanceTotal, FallbackValue=1}"
                    Minimum="0"
                    Value="{Binding ViewModel.BinanceCurrent}" />
                <TextBlock FontSize="13">
                    <Run Text="{Binding ViewModel.BinanceCurrent}" />
                    <Run Text=" / " />
                    <Run Text="{Binding ViewModel.BinanceTotal}" />
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <!-- 状态 -->
        <TextBlock
            Grid.Row="3"
            FontSize="13"
            FontStyle="Italic"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Margin="0,0,0,8"
            Text="{Binding ViewModel.StatusMessage}" />

        <!-- 日志 -->
        <GroupBox Grid.Row="4" Header="日志">
            <TextBox
                AcceptsReturn="True"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                FontFamily="Consolas"
                FontSize="12"
                IsReadOnly="True"
                Padding="5"
                Text="{Binding ViewModel.StatusLogText, Mode=OneWay}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </GroupBox>
    </Grid>
</Page>
