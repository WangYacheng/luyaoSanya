<Page x:Class="TradeSystem.App.Views.Pages.KLineRankingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TradeSystem.App.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:TradeSystem.App.Converters"
      Title="KLineRankingPage"
      d:DataContext="{d:DesignInstance local:KLineRankingPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="600"
      d:DesignWidth="1000"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <Page.Resources>
        <converters:ChangePctColorConverter x:Key="ChangePctColorConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <Grid Margin="32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: 标题 + 控件 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Margin="0,0,0,12"
                Text="K线排行榜" />
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Margin="0,0,6,0"
                    Text="周期:" />
                <ComboBox
                    Width="90"
                    Height="30"
                    Margin="0,0,12,0"
                    DisplayMemberPath="Key"
                    ItemsSource="{Binding ViewModel.Periods}"
                    SelectedValue="{Binding ViewModel.SelectedPeriod}"
                    SelectedValuePath="Value" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Margin="0,0,6,0"
                    Text="K线根数:" />
                <TextBox
                    Width="60"
                    Height="30"
                    Margin="0,0,16,0"
                    Text="{Binding ViewModel.KLineCount, UpdateSourceTrigger=PropertyChanged}"
                    VerticalContentAlignment="Center" />
                <Button
                    Width="120"
                    Height="34"
                    Margin="0,0,8,0"
                    Background="#1A1A1A"
                    BorderThickness="0"
                    Command="{Binding ViewModel.LoadOkxRankingCommand}"
                    Content="OKX 排行榜"
                    Cursor="Hand"
                    FontSize="13"
                    Foreground="White">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
                <Button
                    Width="120"
                    Height="34"
                    Background="#F0B90B"
                    BorderThickness="0"
                    Command="{Binding ViewModel.LoadBinanceRankingCommand}"
                    Content="Binance 排行榜"
                    Cursor="Hand"
                    FontSize="13"
                    Foreground="#1E2329">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Row 1: OKX + Binance -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- OKX 排行榜 -->
            <GroupBox Grid.Column="0" Header="OKX 排行榜 (前15)">
                <Grid Margin="0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- OKX 导航 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button
                            Width="110"
                            Height="28"
                            Margin="0,0,6,0"
                            Command="{Binding ViewModel.GoToOkxPrevCommand}"
                            Content="{Binding ViewModel.PrevButtonText}"
                            FontSize="12">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.OkxCanGoPrev}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,0,6,0"
                            Text="{Binding ViewModel.OkxPeriodText}" />
                        <Button
                            Width="110"
                            Height="28"
                            Margin="0,0,6,0"
                            Command="{Binding ViewModel.GoToOkxNextCommand}"
                            Content="{Binding ViewModel.NextButtonText}"
                            FontSize="12">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.OkxCanGoNext}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button
                            Width="50"
                            Height="28"
                            Command="{Binding ViewModel.GoToOkxLatestCommand}"
                            Content="最新"
                            FontSize="12" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListView
                            ItemsSource="{Binding ViewModel.OkxRankings}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="30" DisplayMemberBinding="{Binding Rank}">
                                        <GridViewColumnHeader Content="#" />
                                    </GridViewColumn>
                                    <GridViewColumn Width="75" DisplayMemberBinding="{Binding Symbol}">
                                        <GridViewColumnHeader Content="币种" />
                                    </GridViewColumn>
                                    <GridViewColumn Width="85">
                                        <GridViewColumnHeader Content="涨跌幅" />
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding ChangePct, Converter={StaticResource ChangePctColorConverter}}"
                                                    Text="{Binding ChangePct, StringFormat={}{0:+0.00;-0.00}%}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="90" DisplayMemberBinding="{Binding Open, StringFormat={}{0:F4}}">
                                        <GridViewColumnHeader Content="开盘价" />
                                    </GridViewColumn>
                                    <GridViewColumn Width="100" DisplayMemberBinding="{Binding Volume, StringFormat={}{0:F0}}">
                                        <GridViewColumnHeader Content="成交量" />
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <ProgressBar
                            Height="4"
                            VerticalAlignment="Top"
                            IsIndeterminate="True"
                            Visibility="{Binding ViewModel.IsOkxLoading, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- Binance 排行榜 -->
            <GroupBox Grid.Column="2" Header="Binance 排行榜 (前15)">
                <Grid Margin="0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Binance 导航 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button
                            Width="110"
                            Height="28"
                            Margin="0,0,6,0"
                            Command="{Binding ViewModel.GoToBinancePrevCommand}"
                            Content="{Binding ViewModel.PrevButtonText}"
                            FontSize="12">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.BinanceCanGoPrev}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,0,6,0"
                            Text="{Binding ViewModel.BinancePeriodText}" />
                        <Button
                            Width="110"
                            Height="28"
                            Margin="0,0,6,0"
                            Command="{Binding ViewModel.GoToBinanceNextCommand}"
                            Content="{Binding ViewModel.NextButtonText}"
                            FontSize="12">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.BinanceCanGoNext}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button
                            Width="50"
                            Height="28"
                            Command="{Binding ViewModel.GoToBinanceLatestCommand}"
                            Content="最新"
                            FontSize="12" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListView
                            ItemsSource="{Binding ViewModel.BinanceRankings}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="30" DisplayMemberBinding="{Binding Rank}">
                                        <GridViewColumnHeader Content="#" />
                                    </GridViewColumn>
                                    <GridViewColumn Width="75" DisplayMemberBinding="{Binding Symbol}">
                                        <GridViewColumnHeader Content="币种" />
                                    </GridViewColumn>
                                    <GridViewColumn Width="85">
                                        <GridViewColumnHeader Content="涨跌幅" />
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding ChangePct, Converter={StaticResource ChangePctColorConverter}}"
                                                    Text="{Binding ChangePct, StringFormat={}{0:+0.00;-0.00}%}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="90" DisplayMemberBinding="{Binding Open, StringFormat={}{0:F4}}">
                                        <GridViewColumnHeader Content="开盘价" />
                                    </GridViewColumn>
                                    <GridViewColumn Width="100" DisplayMemberBinding="{Binding Volume, StringFormat={}{0:F0}}">
                                        <GridViewColumnHeader Content="成交量" />
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <ProgressBar
                            Height="4"
                            VerticalAlignment="Top"
                            IsIndeterminate="True"
                            Visibility="{Binding ViewModel.IsBinanceLoading, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Row 2: 状态栏 -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ViewModel.StatusMessage}" />
        </StackPanel>
    </Grid>
</Page>
