<Page x:Class="TradeSystem.App.Views.Pages.RankingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TradeSystem.App.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:TradeSystem.App.Converters"
      Title="RankingPage"
      d:DataContext="{d:DesignInstance local:RankingPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="600"
      d:DesignWidth="1000"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <Page.Resources>
        <converters:ChangePctColorConverter x:Key="ChangePctColorConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <Grid Margin="32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: 日期导航 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Margin="0,0,0,12"
                Text="日内涨幅榜" />
            <StackPanel Orientation="Horizontal">
                <Button
                    Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Command="{Binding ViewModel.GoToPreviousDayCommand}"
                    Content="◀ 上一天"
                    FontSize="13" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="0,0,8,0"
                    Text="{Binding ViewModel.SelectedDateText}" />
                <Button
                    Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Command="{Binding ViewModel.GoToNextDayCommand}"
                    Content="下一天 ▶"
                    FontSize="13">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.IsToday}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button
                    Width="80"
                    Height="34"
                    Command="{Binding ViewModel.GoToTodayCommand}"
                    Content="今天"
                    FontSize="13" />
            </StackPanel>
        </StackPanel>

        <!-- Row 1: OKX + Binance -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- OKX 涨幅榜 -->
            <GroupBox Grid.Column="0" Header="OKX 涨幅榜 (前15)">
                <ListView
                    Margin="0,4"
                    ItemsSource="{Binding ViewModel.OkxRankings}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="35" DisplayMemberBinding="{Binding Rank}">
                                <GridViewColumnHeader Content="#" />
                            </GridViewColumn>
                            <GridViewColumn Width="75" DisplayMemberBinding="{Binding Symbol}">
                                <GridViewColumnHeader Content="币种" />
                            </GridViewColumn>
                            <GridViewColumn Width="90">
                                <GridViewColumnHeader Content="24h涨幅" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding ChangePct, Converter={StaticResource ChangePctColorConverter}}"
                                            Text="{Binding ChangePct, StringFormat={}{0:+0.00;-0.00}%}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="95" DisplayMemberBinding="{Binding LastPrice, StringFormat={}{0:F4}}">
                                <GridViewColumnHeader Content="最新价" />
                            </GridViewColumn>
                            <GridViewColumn Width="110" DisplayMemberBinding="{Binding Volume, StringFormat={}{0:F0}}">
                                <GridViewColumnHeader Content="成交量" />
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <!-- Binance 涨幅榜 -->
            <GroupBox Grid.Column="2" Header="Binance 涨幅榜 (前30)">
                <ListView
                    Margin="0,4"
                    ItemsSource="{Binding ViewModel.BinanceRankings}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="35" DisplayMemberBinding="{Binding Rank}">
                                <GridViewColumnHeader Content="#" />
                            </GridViewColumn>
                            <GridViewColumn Width="75" DisplayMemberBinding="{Binding Symbol}">
                                <GridViewColumnHeader Content="币种" />
                            </GridViewColumn>
                            <GridViewColumn Width="90">
                                <GridViewColumnHeader Content="24h涨幅" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding ChangePct, Converter={StaticResource ChangePctColorConverter}}"
                                            Text="{Binding ChangePct, StringFormat={}{0:+0.00;-0.00}%}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="95" DisplayMemberBinding="{Binding LastPrice, StringFormat={}{0:F4}}">
                                <GridViewColumnHeader Content="最新价" />
                            </GridViewColumn>
                            <GridViewColumn Width="110" DisplayMemberBinding="{Binding Volume, StringFormat={}{0:F0}}">
                                <GridViewColumnHeader Content="成交量" />
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>
        </Grid>

        <!-- Row 2: 状态栏 -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <ProgressBar
                Height="4"
                Margin="0,0,0,4"
                IsIndeterminate="True"
                Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVis}}" />
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding ViewModel.StatusMessage}" />
        </StackPanel>
    </Grid>
</Page>
